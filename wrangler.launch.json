{
  "name": "inbox-angel-launch-worker",
  "account_id": "f8a1abc24625b0ca9f9e34d87395c67c",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*", "/health"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "OAUTH_KV_ID_PLACEHOLDER" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inbox-angel-launch",
      "database_id": "2bda3efd-7c4e-4fa4-bef0-7ccd164c51e7",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      { "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "731001", "simple": { "limit": 10, "period": 60 } },
      { "name": "API_LIMITER", "type": "ratelimit", "namespace_id": "731002", "simple": { "limit": 200, "period": 60 } }
    ]
  },
  "triggers": { "crons": [] },
  "vars": {
    "WORKER_NAME": "inbox-angel-launch-worker",
    "MODE": "selfhost",
    "OWNER_EMAIL": "maxfindel@pm.me",
    "ONBOARDING_SEQUENCE_ENABLED": "0",
    "BETTER_AUTH_URL": "https://inbox-angel-launch-worker.fellowshipdev.workers.dev"
  }
}
