{
	"name": "@inbox-angel/ui",
	"version": "0.1.0",
	"description": "Inbox Angel design system: tokens, Tailwind 4 theme and React components shared by the dashboard and the website.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./tokens": {
			"types": "./dist/tokens/tokens.d.ts",
			"import": "./dist/tokens/tokens.js"
		},
		"./styles.css": "./dist/styles/styles.css",
		"./tokens.css": "./dist/styles/tokens.css",
		"./theme.css": "./dist/styles/theme.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
		"typecheck": "tsc -p .",
		"test": "npm run build && vitest run",
		"dev:gallery": "vite --config gallery/vite.config.ts",
		"build:gallery": "vite build --config gallery/vite.config.ts",
		"screenshots": "npm run build:gallery && node scripts/screenshots.mjs"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-toast": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.62.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"playwright": "^1.64.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
