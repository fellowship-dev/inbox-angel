{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"types": [],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"strict": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": []
}
