    "./dkim": "./src/dkim.ts",
    "./mx": "./src/mx.ts",
    "./mta-sts": "./src/mta-sts.ts",
    "./bimi": "./src/bimi.ts",
    "./providers": "./src/providers.ts",
    "./org-domain": "./src/org-domain.ts",
    "./email-service-providers": "./src/email-service-providers.ts",
    "./sender-providers": "./src/sender-providers.ts",
