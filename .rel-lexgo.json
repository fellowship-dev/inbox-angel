{
  "name": "ready-set-mail",
  "account_id": "46840e7343b9c1cec0eb9a1323519f69",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/*",
      "/health",
      "/llms.txt"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "3350169768f44c719666392f98a4874a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ready-set-mail",
      "database_id": "ade32386-ef7a-476c-b77d-4a8587c16e00",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_LIMITER",
        "type": "ratelimit",
        "namespace_id": "742001",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "API_LIMITER",
        "type": "ratelimit",
        "namespace_id": "742002",
        "simple": {
          "limit": 200,
          "period": 60
        }
      },
      {
        "name": "DNS_PREVIEW_LIMITER",
        "type": "ratelimit",
        "namespace_id": "742003",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "MCP_LIMITER",
        "type": "ratelimit",
        "namespace_id": "742004",
        "simple": {
          "limit": 100,
          "period": 60
        }
      },
      {
        "name": "OAUTH_TOKEN_LIMITER",
        "type": "ratelimit",
        "namespace_id": "742005",
        "simple": {
          "limit": 600,
          "period": 60
        }
      },
      {
        "name": "MCP_ANON_LIMITER",
        "type": "ratelimit",
        "namespace_id": "742006",
        "simple": {
          "limit": 60,
          "period": 60
        }
      }
    ]
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "WORKER_NAME": "ready-set-mail",
    "MODE": "selfhost",
    "ONBOARDING_SEQUENCE_ENABLED": "0",
    "BETTER_AUTH_URL": "https://ready-set-mail.lexgo-cl.workers.dev"
  }
}
